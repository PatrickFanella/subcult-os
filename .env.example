# Copy to .env for local development in derived projects.
# Never commit .env.

PROJECT_NAME=subcult-os
COMPOSE_PROJECT_NAME=subcult-os

# Optional local Postgres profile used by docker-compose.yml.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# High local host ports avoid common service conflicts.
POSTGRES_PORT=35432
API_PORT=38080
WEB_PORT=38079

APP_ENV=development
API_ADDR=:8080

# Production must override SESSION_SECRET with a non-default value of at least 24 characters.
SESSION_SECRET=dev-session-secret-change-me

# Production should set PUBLIC_WEB_URL to the HTTPS browser origin.
PUBLIC_WEB_URL=http://localhost:38079

# Production should provide DATABASE_URL through the deployment secret store.
# DATABASE_URL=postgres://app:change-me@postgres:5432/app?sslmode=require

# Optional Stripe paid-ticketing settings for local testing.
# STRIPE_SECRET_KEY=sk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Optional local test database URL.
# TEST_DATABASE_URL=postgres://app:change-me@localhost:35432/app?sslmode=disable
